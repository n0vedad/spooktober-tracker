{
  "name": "backend",
  "type": "module",
  "license": "0BSD",
  "scripts": {
    "dev": "node scripts/wait-for-db.mjs && tsx watch src/server.ts",
    "dev:db": "pglite-server --db=.pglite-dev --port=55434 --max-connections=1",
    "dev:db:reset": "node -e \"require('fs').rmSync('.pglite-dev', { recursive: true, force: true })\" && echo 'Local dev database deleted'",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/backend/src/server.js",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "gen-key": "node scripts/gen-oauth-key.mjs",
    "labeler-key": "node scripts/labeler-key.mjs",
    "labeler-setup": "tsx scripts/labeler-setup.ts"
  },
  "dependencies": {
    "@atcute/cbor": "^2",
    "@atcute/crypto": "^2",
    "@atcute/identity-resolver": "^2.0.2",
    "@atcute/identity-resolver-node": "^2.0.1",
    "@atcute/lexicons": "^2.1.1",
    "@atcute/oauth-node-client": "^2.0.1",
    "@atproto/lex": "^0.3.14",
    "@bsky/jetstream": "^1.0.0",
    "cookie": "^2.0.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@9.12.2+sha512.22721b3a11f81661ae1ec68ce1a7b879425a1ca5b991c975b074ac220b187ce56c708fe5db69f4c962c989452eee76c82877f4ee80f474cebd61ee13461b6228"
}
